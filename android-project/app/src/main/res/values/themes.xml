<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Call" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Call.Fullscreen" parent="Theme.Call">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
    </style>
</resources>
